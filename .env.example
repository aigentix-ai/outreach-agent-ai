# LLM providers. The engine prioritizes Gemini, with fallback to NVIDIA / OpenRouter.
# Multi-Key Gemini Rotation: add multiple keys to avoid burnout & rate limits (429)
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Specialized Gemini Models per task (High Speed vs Deep Nuanced Reasoning)
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Fallback LLM Providers (Optional)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_APP_NAME=Outreach Engine
OPENROUTER_APP_URL=

# Gmail OAuth (Draft-only mode keeps outreach 100% review-safe)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Optional: Meta Ad Library Graph API
META_ACCESS_TOKEN=
